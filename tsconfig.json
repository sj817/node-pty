{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "runtime/**/*.ts",
    "test/*.test.ts",
    "test/registry.ts",
    "test/smoke.ts"
  ]
}
